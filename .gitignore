# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Environment
.env
.venv/
venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Database (large, symlinked or mounted)
miniweb.db
*.db-shm
*.db-wal

# Data sources (external, not in repo)
data_sources/

# Generated assets
app/static/generated/
app/static/lakeport-tiles.js

# Evaluation results (generated per run)
evaluation/results/
evaluation/logs/

# Upload artifacts (user-generated at runtime)
sites/*/data/uploads/
sites/*/static/uploads/

# Annotation runtime artifacts
annotation/annotation.db
annotation/annotation.db-shm
annotation/annotation.db-wal
annotation/tasks/

# Google Cloud credentials
google_key.json
*.json.bak

# Claude Code
.claude/

key.json
# ignore data/ contents except the site-review baseline (deployed with the app);
# a bare "data" rule would make the !data/reviews exception impossible
data/*
!data/reviews/
annotation/floor_config.json
evaluation/fixtures/
evaluation/server_*.log
