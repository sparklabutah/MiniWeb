# Evaluation results (generated per run)
src/miniweb/evaluation/results
# AgentLab/BrowserGym study dirs (AGENTLAB_EXP_ROOT)
src/miniweb/evaluation/results/agentlab/
src/miniweb/evaluation/logs/

# Upload artifacts (user-generated at runtime)
src/miniweb/sites/*/data/uploads/
src/miniweb/sites/*/static/uploads/
data/uploads/

# Annotation runtime artifacts
src/miniweb/annotation/annotation.db
src/miniweb/annotation/annotation.db-shm
src/miniweb/annotation/annotation.db-wal
src/miniweb/annotation/tasks/

# Google Cloud credentials
google_key.json
*.json.bak

# Claude Code
.claude/

key.json
# ignore data/ contents except the site-review baseline and the canonical macro
# registry — both static config deployed with the app (a bare "data" rule would
# make the !data/... exceptions impossible)
data/*
!data/macros.yaml
!data/macro_locations.yaml
!data/final_set.yaml
!data/sites.yaml
!data/README.md
# datagen: the train/test site split and the per-macro guides are tracked; site maps and runs are not
!data/datagen/
data/datagen/*
!data/datagen/site_split.json
!data/datagen/guides/
src/miniweb/annotation/floor_config.json
src/miniweb/evaluation/fixtures/
src/miniweb/evaluation/*.log
src/miniweb/evaluation/audit_slices
src/miniweb/evaluation/server_*.log
src/miniweb/evaluation/gemini_run.log

*.csv
# CSVs the app needs: the annotation tool's proposed graph edges and the simulated file system
!src/miniweb/annotation/proposed_edges.csv
!src/miniweb/filesystem/**/*.csv
*.pptx
# Local scratch/working files (not part of the project)
scratchpad/
policy.yaml
models/

# 2026-10-08 (user: "dont put docs to github"): docs/ -- paper drafts, figures, research notes -- stays local
docs/
# stray run logs and working spreadsheets
webmix_logs/
*.xlsx
# a separate repository, not vendored here
method/hyperWeb/

