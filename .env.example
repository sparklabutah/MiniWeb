# MiniWeb configuration: cp .env.example .env, then fill in what you use.
# Real environment variables win over this file. Relative paths are relative to the repository.

# The site database and the tasks. These are the defaults, where scripts/restore_site_db.py and
# scripts/fetch_tasks.py put them; change them only to use copies elsewhere.
MINIWEB_DB="data/miniweb.db"
MINIWEB_ANNOTATIONS_DIR="data/annotations"

# Logins of the annotation tool at /annotate/
# MINIWEB_ANNOTATORS="alice:secret,bob:secret"

# LLM keys, only for the providers you use (routing: src/helpers/llm.py). The sites need none; the VLM judge,
# MiniWebGen and the verifiers' free-text checks call Gemini, the live-web judges call OpenAI.
# GEMINI_API_KEY=...
# GOOGLE_GENAI_USE_VERTEXAI=true    (Vertex instead of a key, with GOOGLE_CREDENTIALS_JSON)
# OPENAI_API_KEY=...
